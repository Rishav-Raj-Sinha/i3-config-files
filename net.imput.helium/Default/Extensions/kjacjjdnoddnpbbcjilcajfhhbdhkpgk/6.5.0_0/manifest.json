{
   "action": {
      "default_icon": {
         "128": "logo/128.png",
         "16": "logo/16.png",
         "32": "logo/32.png",
         "48": "logo/48.png"
      },
      "default_popup": "src/popup/index.html"
   },
   "author": {
      "email": "developer@forestapp.cc"
   },
   "background": {
      "service_worker": "src/background/index.js",
      "type": "module"
   },
   "content_scripts": [ {
      "exclude_matches": [ "https://auth.staging.seekrtech.com/*", "https://auth.seekrtech.com/*", "https://auth.upwardsware.com/*" ],
      "js": [ "src/content/index.js" ],
      "matches": [ "http://*/*", "https://*/*" ]
   } ],
   "default_locale": "en",
   "description": "__MSG_appDesc__",
   "externally_connectable": {
      "ids": [ "*" ],
      "matches": [ "https://auth.seekrtech.com/*", "https://auth.upwardsware.com/*", "https://auth.staging.seekrtech.com/*" ]
   },
   "homepage_url": "https://www.forestapp.cc",
   "host_permissions": [ "http://*/*", "https://*/*" ],
   "icons": {
      "128": "logo/128.png",
      "16": "logo/16.png",
      "32": "logo/32.png",
      "48": "logo/48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_appName__",
   "options_ui": {
      "open_in_tab": true,
      "page": "src/options/index.html"
   },
   "permissions": [ "scripting", "storage", "unlimitedStorage", "notifications", "activeTab", "tabs", "offscreen", "identity", "alarms" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "6.5.0",
   "web_accessible_resources": [ {
      "matches": [ "*://*/*" ],
      "resources": [ "/images/*", "/assets/*" ]
   } ]
}
